# Copy this file to .env and fill in real values. .env is git-ignored.

# Postgres
POSTGRES_DB=progressDbName
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourStrong(!)Password

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=yourStrong(!)Password

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=yourStrong(!)Password
MINIO_DEFAULT_BUCKETS=my-bucket

# Identity module
IDENTITY_JWT_SIGNING_KEY=
IDENTITY_JWT_EXPIRES_IN_MINUTES=120
IDENTITY_HASHED_TOKEN_SIGNING_KEY=

# File object store (MinIO client settings used by the API)
FILE_OBJECT_STORE_URL=http://minio:9000
FILE_OBJECT_STORE_USER=
FILE_OBJECT_STORE_SECRET=
FILE_OBJECT_STORE_USE_SSL=false
FILE_OBJECT_STORE_BUCKET_NAME=my-bucket
