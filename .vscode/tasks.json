{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dotnet build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/GamesGlobal.ShoppingList.sln"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "dotnet format",
			"command": "dotnet",
			"type": "process",
			"args": [
				"format",
				"--report",
				"issues.json",
				".\\GamesGlobal.ShoppingList.sln"
			],
			"group": "none",
			"problemMatcher": []
		},
		{
			"label": "dotnet test",
			"command": "dotnet",
			"type": "process",
			"args": [
				"test",
				".\\GamesGlobal.ShoppingList.sln"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "dotnet clean",
			"command": "dotnet",
			"type": "process",
			"args": [
				"clean",
				".\\GamesGlobal.ShoppingList.sln"
			],
			"group": "none",
			"problemMatcher": []
		}
	]
}