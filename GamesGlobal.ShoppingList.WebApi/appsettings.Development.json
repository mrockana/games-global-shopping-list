{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "postgres": "Host=localhost;Port=5432;Database=ShoppingItemsAppDB;Username=postgres;Password=yourStrong(!)Password;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    },
    "OpenTelemetry": {
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true
    }
  },
  "OtelExport": {
    "Endpoint": "http://localhost:4317"
  },
  "IdentityModuleOptions": {
    "ApplicationUrl": "https://localhost:7223",
    "JwtSigningKey": "",
    "HashedTokenSigningKey": "",
    "JwtExpiresInMinutes": 15,
    "RefreshTokenExpiresInMinutes": 2880,
    "ForgotPasswordRequestExpiresInMinutes": 2880,
    "ForgotPasswordRequestCodeLength": 8
  },

  "RateLimiterModuleOptions": {
    "WindowPermitLimit": 5,
    "TokenLimit": 5,
    "TokensPerPeriod": 5,
    "WindowTimeLimitInSeconds": 60,
    "ReplenishmentPeriodInSeconds": 60
  }
}
