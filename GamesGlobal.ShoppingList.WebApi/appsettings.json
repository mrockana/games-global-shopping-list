{
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "postgres": ""
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Information"
        },
        "OpenTelemetry": {
            "IncludeFormattedMessage": true,
            "IncludeScopes": true,
            "ParseStateValues": true
        }
    },
    "OtelExport": {
        "Endpoint": ""
    },
  "IdentityModuleOptions": {
    "ApplicationUrl": "",
    "JwtSigningKey": "",
    "HashedTokenSigningKey": "",
    "JwtExpiresInMinutes": 1,
    "RefreshTokenExpiresInMinutes": 1000,
    "ForgotPasswordRequestExpiresInMinutes": 2880,
    "ForgotPasswordRequestCodeLength": 8
  },
  "RateLimiterModuleOptions": {
    "WindowPermitLimit": 5,
    "TokenLimit": 5,
    "TokensPerPeriod": 5,
    "WindowTimeLimitInSeconds": 60,
    "ReplenishmentPeriodInSeconds": 60
  }
}
